local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer
local Char, HRP

local ESPEnabled = true
local UIVisible = true

-- =========================
-- UPDATE CHAR
-- =========================

local function UpdateChar()
    Char = LP.Character or LP.CharacterAdded:Wait()
    HRP = Char:WaitForChild("HumanoidRootPart")
end

UpdateChar()
LP.CharacterAdded:Connect(UpdateChar)

-- =========================
-- ROLE
-- =========================

local function GetRole(plr)
    local b = plr:FindFirstChild("Backpack")
    local c = plr.Character

    if (b and b:FindFirstChild("Knife")) or (c and c:FindFirstChild("Knife")) then
        return "Murder"
    end

    if (b and b:FindFirstChild("Gun")) or (c and c:FindFirstChild("Gun")) then
        return "Sheriff"
    end

    return "Innocent"
end

local function GetColor(role)
    if role == "Murder" then
        return Color3.fromRGB(255,0,0)
    elseif role == "Sheriff" then
        return Color3.fromRGB(0,0,255)
    else
        return Color3.fromRGB(0,255,0)
    end
end

local function GetMurder()
    for _,plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and GetRole(plr) == "Murder" then
            return plr
        end
    end
end

-- =========================
-- PLAYER ESP
-- =========================

local function AddESP(plr)
    if plr == LP or not plr.Character then
        return
    end

    if plr.Character:FindFirstChild("ESP") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = "ESP"
    h.FillTransparency = 0.3
    h.OutlineTransparency = 0
    h.Adornee = plr.Character
    h.Parent = plr.Character
end

task.spawn(function()
    while task.wait(1) do
        if ESPEnabled then
            for _,plr in pairs(Players:GetPlayers()) do
                if plr ~= LP and plr.Character then
                    AddESP(plr)

                    local esp = plr.Character:FindFirstChild("ESP")

                    if esp then
                        local color = GetColor(GetRole(plr))

                        esp.FillColor = color
                        esp.OutlineColor = color
                    end
                end
            end
        end
    end
end)

-- =========================
-- GUN DROP ESP
-- =========================

local function AddGunDropESP(obj)
    if not obj then
        return
    end

    if obj:IsA("BasePart") then
        if obj:FindFirstChild("GunESP") then
            return
        end

        local h = Instance.new("Highlight")
        h.Name = "GunESP"
        h.FillColor = Color3.fromRGB(255,255,0)
        h.OutlineColor = Color3.fromRGB(255,255,0)
        h.FillTransparency = 0.2
        h.OutlineTransparency = 0
        h.Adornee = obj
        h.Parent = obj

    elseif obj:FindFirstChild("Handle") then
        local handle = obj.Handle

        if handle:FindFirstChild("GunESP") then
            return
        end

        local h = Instance.new("Highlight")
        h.Name = "GunESP"
        h.FillColor = Color3.fromRGB(255,255,0)
        h.OutlineColor = Color3.fromRGB(255,255,0)
        h.FillTransparency = 0.2
        h.OutlineTransparency = 0
        h.Adornee = handle
        h.Parent = handle
    end
end

task.spawn(function()
    while task.wait(1) do
        local gunDrop = workspace:FindFirstChild("GunDrop", true)

        if gunDrop then
            AddGunDropESP(gunDrop)
        end
    end
end)

-- =========================
-- SMART PREDICT
-- =========================

local function Predict(part)
    local pos = part.Position
    local vel = part.AssemblyLinearVelocity
    local distance = (HRP.Position - pos).Magnitude

    if distance < 10 then
        return pos
    end

    local horizontalVel = Vector3.new(vel.X,0,vel.Z)

    local moveDir =
        horizontalVel.Magnitude > 0
        and horizontalVel.Unit
        or Vector3.zero

    local toUs = (HRP.Position - pos).Unit

    local dot = moveDir:Dot(toUs)

    if dot > 0.7 then
        return pos
    end

    local predictAmount = 0.08

    local predicted = pos + (horizontalVel * predictAmount)

    if math.abs(vel.Y) > 2 then
        predicted += Vector3.new(0, vel.Y * 0.04, 0)
    end

    return predicted
end

-- =========================
-- SHOOT
-- =========================

local function ShootOnce()
    local m = GetMurder()

    if not m or not m.Character then
        return
    end

    local target =
        m.Character:FindFirstChild("Head")
        or m.Character:FindFirstChild("HumanoidRootPart")

    local gun =
        LP.Backpack:FindFirstChild("Gun")
        or LP.Character:FindFirstChild("Gun")

    if target and gun and gun:FindFirstChild("Handle") then
        local shoot = gun:FindFirstChild("Shoot")

        if shoot then
            local pos = Predict(target)

            shoot:FireServer(
                CFrame.new(gun.Handle.Position, pos),
                CFrame.new(pos)
            )
        end
    end
end

-- =========================
-- GRAB GUN
-- =========================

local function GrabGun()
    local gunDrop = workspace:FindFirstChild("GunDrop", true)

    if gunDrop and HRP then
        if gunDrop:IsA("BasePart") then
            gunDrop.CFrame = HRP.CFrame

        elseif gunDrop:FindFirstChild("Handle") then
            gunDrop.Handle.CFrame = HRP.CFrame
        end
    end
end

-- =========================
-- BRING + NOCLIP
-- =========================

local BringEnabled = false
local NoclipConnection

local function SetNoclip(state)
    if state then
        NoclipConnection = RunService.Stepped:Connect(function()
            if Char then
                for _,v in pairs(Char:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

local function BringPlayers()
    if not HRP then
        return
    end

    for _,plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local targetHRP = plr.Character:FindFirstChild("HumanoidRootPart")

            if targetHRP then
                targetHRP.CFrame =
                    HRP.CFrame * CFrame.new(0,0,-5)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        if BringEnabled then
            BringPlayers()
        end
    end
end)

-- =========================
-- UI
-- =========================

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

local function Dragify(btn)
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then

            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart

            btn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

            dragging = false
        end
    end)
end

local function MakeButton(text, posY)
    local b = Instance.new("TextButton")

    b.Parent = ScreenGui
    b.Size = UDim2.new(0,90,0,90)
    b.Position = UDim2.new(0.88,0,posY,0)

    b.Text = text
    b.TextScaled = true

    b.BackgroundColor3 = Color3.fromRGB(255,255,255)
    b.BackgroundTransparency = 0.3

    Instance.new("UICorner",b).CornerRadius = UDim.new(1,0)

    local stroke = Instance.new("UIStroke")
    stroke.Parent = b
    stroke.Thickness = 2

    Dragify(b)

    return b
end

local FireBtn = MakeButton("FIRE",0.72)
local GrabBtn = MakeButton("GRAB",0.57)

-- =========================
-- BUTTONS
-- =========================

FireBtn.MouseButton1Click:Connect(function()
    ShootOnce()
end)

GrabBtn.MouseButton1Click:Connect(function()
    GrabGun()
end)

-- =========================
-- TOGGLE UI
-- =========================

local function ToggleUI()
    UIVisible = not UIVisible

    for _,v in pairs(ScreenGui:GetChildren()) do
        if v:IsA("TextButton") then
            v.Visible = UIVisible
        end
    end

    ESPEnabled = UIVisible

    if not UIVisible then
        for _,v in pairs(workspace:GetDescendants()) do
            if v:IsA("Highlight") then
                v:Destroy()
            end
        end
    end
end

-- =========================
-- KEYBINDS
-- =========================

UIS.InputBegan:Connect(function(input,gp)
    if gp then
        return
    end

    -- ยิง
    if input.KeyCode == Enum.KeyCode.E then
        ShootOnce()
    end

    -- ดูดปืน
    if input.KeyCode == Enum.KeyCode.G then
        GrabGun()
    end

    -- ซ่อน UI
    if input.KeyCode == Enum.KeyCode.H then
        ToggleUI()
    end

    -- Bring + Noclip
    if input.KeyCode == Enum.KeyCode.K then
        BringEnabled = not BringEnabled

        SetNoclip(BringEnabled)
    end
end)
